    <!-- ══════════════════════════════════════════════════════════ -->
    <mxCell id="legend-box" value="&lt;b&gt;🔄 Flujo Registro Asistencia&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;① Estudiante abre Dashboard&lt;br&gt;② GET /mis-materias/ → materias del día&lt;br&gt;③ Toca &amp;quot;Marcar Asistencia&amp;quot; → captura selfie&lt;br&gt;④ POST /registrar/ → imagen base64&lt;br&gt;⑤ Django → AWS Rekognition (SearchFaces)&lt;br&gt;⑥ Rekognition retorna confianza&lt;br&gt;⑦ Django crea Asistencia (PRESENTE/TARDE/AUSENTE)&lt;br&gt;⑧ Dashboard actualiza indicador visual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#27AE60;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
